#!/bin/bash
# Start the live code reviewer in the foreground and stream its output.
# Ctrl+C stops everything.
DIR="$HOME/screenpipe-review"
INTERVAL="${INTERVAL:-10}"
mkdir -p "$DIR/output" "$DIR/state"
touch "$DIR/output/feed.log" "$DIR/state/run.log"
rm -rf "$DIR/state/lock.d" "$DIR/state/last_reviewed.txt"   # review right away on start

if ! "$DIR/helper" winid "${WINDOW_MATCH:-MeowDisplay}" >/dev/null; then
  echo "⚠️  MeowDisplay window not found — open it; reviewing starts automatically once it appears."
fi

clear
printf '\033[1mLive code review\033[0m — model %s, every %ss · Ctrl+C to stop\n' \
  "${REVIEW_MODEL:-claude-sonnet-5-5}" "$INTERVAL"
printf 'Problem context: %s\n\n' "$DIR/output/problem_context.md"

# stream replies + status lines (status in grey)
tail -q -n 0 -F "$DIR/output/feed.log" "$DIR/state/run.log" 2>/dev/null |
  while IFS= read -r line; do
    case "$line" in
      20[0-9][0-9]-*) printf '\r\033[K\033[2m%s\033[0m\n' "$line" ;;
      *) printf '\r\033[K%s\n' "$line" ;;
    esac
  done &
TAIL=$!

cleanup() {
  trap - INT TERM; exec 2>/dev/null
  pkill -P $$ 2>/dev/null                      # sleep / review.sh / tail pipeline
  pkill -f "tail -q -n 0 -F $DIR" 2>/dev/null
  rm -rf "$DIR/state/lock.d"
  echo; echo "stopped."; exit 0
}
trap cleanup INT TERM

# run children in background + wait, so Ctrl+C is handled immediately
while true; do
  "$DIR/review.sh" & wait $!
  printf '\r\033[K\033[2m⏱ %s checked · %s\033[0m' "$(date +%H:%M:%S)" "$(cat "$DIR/state/status" 2>/dev/null)"
  sleep "$INTERVAL" & wait $!
done
