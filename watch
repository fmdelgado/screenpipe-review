#!/bin/bash
# Live view of the background screen solver (clean solution feed only).
resolve_dir() {
  local src="$1"
  while [ -L "$src" ]; do
    local dir
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}
DIR="${SCREENPIPE_DIR:-$(resolve_dir "$0")}"
P=~/Library/LaunchAgents/com.fernando.screenpipe-review.plist
[ -f "$P" ] && { launchctl list | grep -q com.fernando.screenpipe-review || launchctl load "$P"; }
clear
printf '\033[2mLive Solver viewer · Ctrl+C stops this view; background solver keeps running.\033[0m\n'
tail -n 30 -F "$DIR/output/feed.log" 2>/dev/null
